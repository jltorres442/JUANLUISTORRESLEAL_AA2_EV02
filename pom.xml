<?xml version="1.0" encoding="UTF-8"?>
<!--
    Proyecto: Homecenter Envíos - Sistema de realización y seguimiento de pedidos
    Evidencia: GA7 - Aplicación web Java (Servlets + JSP + JDBC + MySQL)
    Empaquetado: WAR desplegable en Apache Tomcat 8.5 / 9 (API javax.servlet 3.1+)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>co.homecenter</groupId>
    <artifactId>homecenter-envios</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>Homecenter Envíos</name>
    <description>Aplicación web para la gestión de pedidos, envíos e incidencias de Homecenter.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Se compila para Java 11 para ser compatible con Tomcat 8.5 / 9 y JDK recientes -->
        <maven.compiler.release>11</maven.compiler.release>
    </properties>

    <dependencies>
        <!--
            API de Servlets: la provee el contenedor (Tomcat), por eso el alcance es "provided".
            Se usa la versión 3.1 porque es la que implementa Tomcat 8.5 (XAMPP);
            el mismo WAR funciona sin cambios en Tomcat 9 (Servlet 4.0).
        -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- API de JSP: también la provee el contenedor -->
        <dependency>
            <groupId>javax.servlet.jsp</groupId>
            <artifactId>javax.servlet.jsp-api</artifactId>
            <version>2.3.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSTL: etiquetas c:, fmt: y fn: usadas en las vistas JSP -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>jstl</artifactId>
            <version>1.2</version>
        </dependency>

        <!-- Controlador JDBC oficial de MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <exclusions>
                <!-- Protobuf solo lo usa la X DevAPI de MySQL, que este proyecto no necesita -->
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>homecenter-envios</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
        </plugins>
    </build>
</project>
